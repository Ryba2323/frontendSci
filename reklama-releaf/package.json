  "description": "ReLeaf — „To też się liczy.” Reklama 25 s (Instagram, 9:16). Montaż w Remotion.",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "nagraj-ui": "node scripts/nagraj-ui.cjs",
    "lut": "python3 scripts/lut.py",
    "ujecia": "python3 scripts/przygotuj.py",
    "podglad": "remotion render ReLeaf-ToTezSieLiczy out/podglad-animatik.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --muted && python3 scripts/sprawdz.py out/podglad-animatik.mp4 --bez-dzwieku",
    "final": "bash scripts/final.sh",
    "sprawdz": "python3 scripts/sprawdz.py out/releaf-to-tez-sie-liczy-final.mp4",
    "build": "remotion bundle",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
